companion/aria-reachy-arm64

# Logs
*.log

# Runtime UI settings (selected brain model, etc.)
.aria-settings.json

# OS noise
.DS_Store
Thumbs.db

# Secrets — keep .env out of the repo; it lives only on your machine.
# (Copy .env.example to .env and fill it in to run locally.)
.env
.env.bak
